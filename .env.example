NUXT_PUBLIC_CESIUM_ION_TOKEN=<--your-cesium-ion-token-->
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=<--optional-google-api-key-->
# Bangkok Custom 3D tileset (extruded footprints — NOT Google Photorealistic 3D Tiles)
NUXT_PUBLIC_BANGKOK_PHOTOREALISTIC_TILESET_URL=
# Local verification example (run tile server first):
# BANGKOK_TILES_PORT=8006 npm run bangkok:tiles:serve
# NUXT_PUBLIC_BANGKOK_PHOTOREALISTIC_TILESET_URL=http://localhost:8006/tilesets/bangkok/tileset.json
#
# Production example after self-hosting a Bangkok tileset:
# NUXT_PUBLIC_BANGKOK_PHOTOREALISTIC_TILESET_URL=https://cdn.example.com/tilesets/bangkok/tileset.json
